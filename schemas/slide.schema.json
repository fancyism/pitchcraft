{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kanomwhandev/pitchcraft/schemas/slide.schema.json",
  "title": "PitchCraft Slide DSL",
  "type": "object",
  "required": ["id", "type", "purpose", "message", "title", "layout_family", "visual_strategy", "content"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Stable slug. For code, not shown to the model." },
    "type": {
      "description": "Semantic slide family from the taxonomy. Layout is chosen from intent, never randomly.",
      "enum": [
        "cover", "section-divider", "executive-summary", "big-statement", "big-number", "key-insight",
        "framework", "process", "timeline", "journey", "funnel", "comparison", "before-after", "matrix",
        "table", "data-chart", "kpi-dashboard", "quote", "case-study", "problem-solution",
        "feature-breakdown", "architecture", "ecosystem", "workflow", "roadmap", "strategy",
        "recommendation", "checklist", "faq", "closing", "cta"
      ]
    },
    "purpose": { "type": "string", "description": "The communication job, e.g. explain-framework." },
    "message": { "type": "string", "minLength": 1, "description": "ONE primary message. If you cannot state it in one sentence, the slide is not designed yet." },
    "eyebrow": { "type": "string", "description": "Small label above the title." },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/block" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Claims on this slide that must remain traceable."
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Provenance refs, e.g. source_01_page_14. Never fabricate."
    },
    "visual_strategy": {
      "enum": [
        "typography-only", "structured-cards", "diagram", "svg-infographic", "data-visualization",
        "timeline", "matrix", "process-flow", "editorial-photography", "generated-illustration",
        "conceptual-visual", "iconography", "ui-mockup", "device-mockup", "comparison-table", "architecture-map"
      ]
    },
    "layout_family": {
      "description": "Renderer layout. Supported by render_html.py and export_pptx.mjs.",
      "enum": [
        "cover", "divider", "statement", "big-number", "key-insight", "framework-grid",
        "process-flow", "timeline", "funnel", "comparison", "before-after", "matrix-2x2",
        "table", "chart", "kpi-dashboard", "quote", "case-study", "problem-solution",
        "feature-grid", "roadmap", "checklist", "closing-cta"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path"],
        "additionalProperties": false,
        "properties": {
          "role": { "enum": ["hero", "supporting", "background", "logo"] },
          "path": { "type": "string", "description": "Relative to workspace root, or https URL." },
          "alt": { "type": "string" },
          "credit": { "type": "string" }
        }
      }
    },
    "chart_spec": { "$ref": "#/definitions/chart_spec" },
    "image_spec": {
      "type": "object",
      "description": "Brief for a deliberately composed generated image. The image generator makes the IMAGE; the layout engine keeps TEXT + STRUCTURE. Never ask a generator to produce the whole slide.",
      "additionalProperties": false,
      "properties": {
        "purpose": { "type": "string" },
        "subject": { "type": "string" },
        "aspect_ratio": { "type": "string" },
        "composition": { "type": "string", "description": "e.g. subject-right." },
        "safe_area": { "type": "string", "description": "Region kept clear for typography, e.g. left 42%." },
        "text_in_image": { "type": "boolean", "default": false },
        "background_complexity": { "enum": ["low", "medium", "high"] }
      }
    },
    "emphasis": { "type": "string", "description": "The one element to visually foreground." },
    "speaker_notes": { "type": "string" },
    "qa": { "$ref": "#/definitions/qa" }
  },
  "definitions": {
    "block": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["text", "bullets", "steps", "metrics", "table", "matrix", "quote", "callout"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "minLength": 1 }
          },
          "required": ["text"]
        },
        {
          "properties": {
            "kind": { "const": "bullets" },
            "items": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string" } }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "kind": { "const": "steps" },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 7,
              "items": {
                "type": "object",
                "required": ["title"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string", "description": "Step number, phase name, or time marker." },
                  "title": { "type": "string" },
                  "text": { "type": "string" }
                }
              }
            }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "kind": { "const": "metrics" },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": ["value", "label"],
                "additionalProperties": false,
                "properties": {
                  "value": { "type": "string" },
                  "label": { "type": "string" },
                  "delta": { "type": "string" },
                  "source": { "type": "string" }
                }
              }
            }
          },
          "required": ["items"]
        },
        {
          "properties": {
            "kind": { "const": "table" },
            "columns": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string" } },
            "rows": { "type": "array", "minItems": 1, "items": { "type": "array", "items": { "type": "string" } } }
          },
          "required": ["columns", "rows"]
        },
        {
          "properties": {
            "kind": { "const": "matrix" },
            "axes": {
              "type": "object",
              "required": ["x", "y"],
              "additionalProperties": false,
              "properties": {
                "x": { "type": "object", "required": ["low", "high"], "properties": { "low": { "type": "string" }, "high": { "type": "string" }, "label": { "type": "string" } } },
                "y": { "type": "object", "required": ["low", "high"], "properties": { "low": { "type": "string" }, "high": { "type": "string" }, "label": { "type": "string" } } }
              }
            },
            "cells": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["x", "y", "title"],
                "additionalProperties": false,
                "properties": {
                  "x": { "enum": ["low", "high"] },
                  "y": { "enum": ["low", "high"] },
                  "title": { "type": "string" },
                  "text": { "type": "string" }
                }
              }
            }
          },
          "required": ["axes", "cells"]
        },
        {
          "properties": {
            "kind": { "const": "quote" },
            "text": { "type": "string", "minLength": 1 },
            "attribution": { "type": "string" }
          },
          "required": ["text"]
        },
        {
          "properties": {
            "kind": { "const": "callout" },
            "title": { "type": "string" },
            "text": { "type": "string", "minLength": 1 },
            "tone": { "enum": ["default", "warning", "positive"] }
          },
          "required": ["text"]
        }
      ]
    },
    "chart_spec": {
      "type": "object",
      "required": ["type", "data"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "Chart type follows analytical purpose: trend->line, comparison->bar/column, composition->stacked/donut, flow->funnel. Never decorative.",
          "enum": ["bar", "column", "line", "area", "donut", "stacked-bar", "funnel"]
        },
        "title": { "type": "string" },
        "data": {
          "type": "object",
          "required": ["labels", "series"],
          "additionalProperties": false,
          "properties": {
            "labels": { "type": "array", "minItems": 1, "items": { "type": ["string", "number"] } },
            "series": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "values"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "values": { "type": "array", "minItems": 1, "items": { "type": "number" } }
                }
              }
            },
            "unit": { "type": "string" }
          }
        },
        "takeaway": { "type": "string", "description": "The one sentence the chart proves." },
        "source": { "type": "string", "description": "Where the numbers come from. Shown on-slide." }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["PASS", "WARNING", "FAIL"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "result"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "result": { "enum": ["PASS", "WARNING", "FAIL"] },
              "note": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "accent": { "type": "string" },
            "surface": { "type": "string" },
            "surface_alt": { "type": "string" },
            "text": { "type": "string" },
            "text_muted": { "type": "string" },
            "border": { "type": "string" }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "display": { "type": "string", "description": "Font stack for display/headline roles." },
            "body": { "type": "string" },
            "mono": { "type": "string" },
            "line_height_body": { "type": "number", "minimum": 1.25, "description": "Thai text needs >= 1.25 and no negative tracking." },
            "custom_fonts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["family", "path"],
                "properties": { "family": { "type": "string" }, "path": { "type": "string" }, "weight": { "type": ["string", "number"] }, "style": { "type": "string" } }
              }
            }
          }
        },
        "spacing": { "type": "object" },
        "radius": { "type": "object" }
      }
    }
  }
}
